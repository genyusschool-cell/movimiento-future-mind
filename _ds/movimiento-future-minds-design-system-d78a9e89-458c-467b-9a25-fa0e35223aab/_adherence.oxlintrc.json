      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xxl|xl|lg|md|sm)$/]",
        "message": "<DisplayTitle> size must be one of 'xxl' | 'xl' | 'lg' | 'md' | 'sm'."
      },
