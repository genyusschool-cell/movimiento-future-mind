        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|inverse|ghost)$/]",
        "message": "<IconButton> variant must be one of 'primary' | 'accent' | 'secondary' | 'inverse' | 'ghost'."
