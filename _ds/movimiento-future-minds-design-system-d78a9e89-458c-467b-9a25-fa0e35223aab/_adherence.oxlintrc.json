        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|h4|div|span)$/]",
        "message": "<DisplayTitle> as must be one of 'h1' | 'h2' | 'h3' | 'h4' | 'div' | 'span'."
